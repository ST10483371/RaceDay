@model RaceDay.Web.Models.Race
@{
    ViewData["Title"] = "Edit race";
}

<h1 class="h3 mb-3">Edit race</h1>

<form asp-action="Edit" asp-route-id="@Model.RaceID" method="post" style="max-width: 640px;">
    <input type="hidden" asp-for="RaceID" />
    <partial name="_RaceForm" model="Model" />
    <button type="submit" class="btn btn-primary">Save changes</button>
    <a class="btn btn-link" asp-action="Index">Cancel</a>
</form>
