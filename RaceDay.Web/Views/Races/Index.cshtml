@model IEnumerable<RaceDay.Web.Models.Race>
@{
    ViewData["Title"] = "Races";
    bool isOrganizer = (bool)ViewBag.IsOrganizer;
}

<div class="race-hero d-flex flex-wrap justify-content-between align-items-end gap-3">
    <div>
        <h1>Upcoming races</h1>
        <p>Road, trail and cycling events across South Africa</p>
    </div>
    @if (isOrganizer)
    {
        <a class="btn btn-primary" asp-action="Create">New race</a>
    }
</div>

@if (!string.IsNullOrEmpty((string?)ViewBag.Error))
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

@if (!Model.Any())
{
    <p>No races yet.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-sport align-middle">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Location</th>
                    <th>Start</th>
                    <th>Distance (km)</th>
                    <th>Type</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var race in Model)
                {
                    <tr>
                        <td>@race.Name</td>
                        <td>@race.Location</td>
                        <td>@race.StartTime</td>
                        <td><span class="distance-pill">@race.Distance_km km</span></td>
                        <td>@race.Type</td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@race.RaceID">Details</a>
                            @if (isOrganizer)
                            {
                                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@race.RaceID">Edit</a>
                                <form asp-action="Delete" asp-route-id="@race.RaceID" method="post" class="d-inline"
                                      onsubmit="return confirm('Delete this race?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
